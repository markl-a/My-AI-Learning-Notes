# RAG ChatBot 環境變量配置範例
# 複製此文件為 .env 並填入實際值

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
# 可選：gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo-16k

# ========== Embedding 模型配置 ==========
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 可選模型：
# - all-MiniLM-L6-v2 (輕量級，快速)
# - all-mpnet-base-v2 (高質量)
# - paraphrase-multilingual-MiniLM-L12-v2 (多語言)

# ========== ChromaDB 配置 ==========
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ========== API 服務配置 ==========
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
# 生產環境建議使用多個 worker

# ========== CORS 配置 ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# 逗號分隔的允許源列表

# ========== 日誌配置 ==========
LOG_LEVEL=INFO
# 選項：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# ========== RAG 參數配置 ==========
DEFAULT_TOP_K=3
# 默認檢索的文檔數量
MAX_CONTEXT_LENGTH=4000
# 最大上下文長度（tokens）
TEMPERATURE=0.7
# LLM 溫度參數 (0-1)
MAX_TOKENS=512
# 最大生成 tokens

# ========== 性能配置 ==========
MAX_CONVERSATIONS=1000
# 最大保存的對話數量
CONVERSATION_TTL=3600
# 對話過期時間（秒）
ENABLE_CACHE=true
# 啟用嵌入緩存

# ========== 安全配置 ==========
API_KEY_REQUIRED=false
# 是否需要 API 密鑰
API_KEYS=key1,key2,key3
# API 密鑰列表（逗號分隔）
RATE_LIMIT=100
# 每分鐘請求限制

# ========== 監控配置 ==========
ENABLE_METRICS=true
# 啟用 Prometheus 指標
METRICS_PORT=9090

# ========== 開發/測試配置 ==========
DEBUG=false
TESTING=false
MOCK_OPENAI=false
# 在測試中使用 mock OpenAI

# ========== 數據庫備份配置 ==========
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Cron 格式：每天凌晨 2 點
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=7

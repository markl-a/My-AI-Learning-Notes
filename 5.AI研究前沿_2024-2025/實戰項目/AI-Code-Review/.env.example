# AI Code Review 環境配置

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
# 可選：gpt-4-turbo-preview, gpt-3.5-turbo

# ========== API 配置 ==========
API_HOST=0.0.0.0
API_PORT=8002
API_WORKERS=2

# ========== 審查配置 ==========
DEFAULT_REVIEW_TYPE=full
# 選項：full, quick, security, performance

# ========== 安全檢查配置 ==========
ENABLE_SECRET_SCAN=true
ENABLE_OWASP_CHECK=true
SECURITY_SCORE_THRESHOLD=70

# ========== 性能分析配置 ==========
DEFAULT_ANALYSIS_DEPTH=medium
# 選項：quick, medium, deep
PERFORMANCE_SCORE_THRESHOLD=75

# ========== 日誌配置 ==========
LOG_LEVEL=INFO
LOG_FILE=logs/code_review.log

# ========== Git 配置 ==========
GIT_CLONE_DEPTH=1
MAX_REPO_SIZE_MB=100

# ========== 限制配置 ==========
MAX_CODE_LENGTH=10000
# 最大代碼行數
MAX_FILE_SIZE_MB=1
# 最大文件大小
RATE_LIMIT=100
# 每分鐘請求限制

# ========== 緩存配置 ==========
ENABLE_CACHE=true
CACHE_TTL=3600

# ========== 並發配置 ==========
MAX_CONCURRENT_REVIEWS=5

# ========== 開發/測試 ==========
DEBUG=false
TESTING=false

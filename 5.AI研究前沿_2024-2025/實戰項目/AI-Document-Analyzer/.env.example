# AI Document Analyzer 環境配置

# ========== OpenAI 配置 ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
# 可選：gpt-4, gpt-4-turbo-preview

# ========== Embedding 模型 ==========
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 可選：all-mpnet-base-v2, paraphrase-multilingual-MiniLM-L12-v2

# ========== 服務配置 ==========
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=2

# ========== 存儲配置 ==========
STORAGE_PATH=./documents
MAX_FILE_SIZE=10485760
# 10MB = 10 * 1024 * 1024

# ========== 日誌配置 ==========
LOG_LEVEL=INFO
LOG_FILE=logs/analyzer.log

# ========== 分析參數 ==========
DEFAULT_CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_CONTEXT_LENGTH=4000

# ========== 緩存配置 ==========
ENABLE_CACHE=true
CACHE_TTL=3600

# ========== 安全配置 ==========
CORS_ORIGINS=*
RATE_LIMIT=100

# ========== 開發/測試 ==========
DEBUG=false
TESTING=false

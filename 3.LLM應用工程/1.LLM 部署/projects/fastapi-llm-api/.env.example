# FastAPI LLM API 環境變數配置

# === API Keys ===
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# === 服務配置 ===
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# === 安全配置 ===
API_SECRET_KEY=your-secret-key-change-this-in-production
ENABLE_AUTH=false

# === 功能開關 ===
ENABLE_AI_ASSIST=true
AUTO_OPTIMIZE_PROMPTS=false

# === 速率限制 ===
RATE_LIMIT_PER_MINUTE=60

# === 開發模式 ===
DEBUG=true

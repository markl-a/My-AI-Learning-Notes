# LLM 部署環境變數配置範本
# 複製此檔案為 .env 並填入實際的值

# === API Keys ===
# OpenAI API Key (從 https://platform.openai.com/api-keys 獲取)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (從 https://console.anthropic.com/ 獲取)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key (從 https://makersuite.google.com/app/apikey 獲取)
GOOGLE_API_KEY=your-google-api-key-here

# Cohere API Key
COHERE_API_KEY=your-cohere-api-key-here

# === Hugging Face 配置 ===
# Hugging Face Access Token (用於下載受限模型)
HUGGINGFACE_TOKEN=hf_your-token-here

# 模型快取目錄
HF_HOME=/path/to/huggingface/cache
HF_HUB_CACHE=/path/to/huggingface/hub

# === Ollama 配置 ===
# Ollama API 端點
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434/api

# === 本地模型配置 ===
# 本地模型存儲路徑
MODEL_CACHE_DIR=/path/to/model/cache
LOCAL_MODEL_PATH=/path/to/local/models

# === API 服務配置 ===
# FastAPI 服務配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# API 認證
API_SECRET_KEY=your-secret-key-for-jwt
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# === 推論配置 ===
# 預設模型設定
DEFAULT_MODEL=llama3.1:8b
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512
DEFAULT_TOP_P=0.95

# GPU 配置
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# === 監控配置 ===
# Prometheus 監控
ENABLE_METRICS=true
METRICS_PORT=9090

# 日誌級別
LOG_LEVEL=INFO
LOG_FILE=/var/log/llm-deployment.log

# === 安全性配置 ===
# CORS 設定
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# 速率限制
RATE_LIMIT_PER_MINUTE=60

# === 進階配置 ===
# 批次處理大小
BATCH_SIZE=8
MAX_CONCURRENT_REQUESTS=10

# 快取配置
ENABLE_CACHE=true
CACHE_TTL=3600

# === 開發模式 ===
DEBUG=false
DEVELOPMENT_MODE=false
